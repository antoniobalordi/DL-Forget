+  private String tamarinTerm(Message message) {
+    if (message instanceof Atom a) return a.getValue();
+    if (message instanceof Pair p) return "<" + tamarinTerm(p.getLeft()) + "," + tamarinTerm(p.getRight()) + ">";
+    if (message instanceof Encrypt e) return "senc(" + tamarinTerm(e.getMsg()) + "," + tamarinTerm(e.getKey()) + ")";
+    if (message instanceof PredictiveFunction f) return f.getName() + "(" + f.getArgs().stream().map(this::tamarinTerm).collect(java.util.stream.Collectors.joining(",")) + ")";
+    throw new IllegalArgumentException("Unsupported Forget-DL message " + message);
+  }
