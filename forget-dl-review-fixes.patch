+  private void removeDlSend(ArrayList<Rule> theory, Rule changed) {
+    List<Fact> sends = changed.getPostconditions().stream().filter(f -> isOutboundFact(f.getF_name())).toList();
+    changed.getPostconditions().removeAll(sends);
+    changed.getActions().removeIf(f -> isSendAction(f.getF_name()));
+    for (Rule receiver : theory) {
+      if (receiver == changed) continue;
+      boolean removed = receiver.getPreconditions().removeIf(f -> isInboundFact(f.getF_name()) && sends.stream().anyMatch(s -> sameDlChannel(s, f)));
+      if (removed) receiver.getActions().removeIf(f -> isReceiveAction(f.getF_name()));
