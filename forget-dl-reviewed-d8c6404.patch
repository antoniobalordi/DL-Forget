+    if (received != null && ctx.getTypeOf(received) != null) input.label(received, ctx.getTypeOf(received));
+    for (Rule declaration : branch.theory()) {
+      for (Fact fact : declaration.getPostconditions()) {
+        if ("Type".equals(fact.getF_name().replaceFirst("^!", "")) && fact.getParameters().size() == 3
+            && payloadToString(fact.getParameter(0)).equals(payloadToString(pre.getParameter(0)))) {
+          String label = payloadToString(fact.getParameter(1));
+          input.label(parseStringToMessage(payloadToString(fact.getParameter(2))), label.replace("'", ""));
+        }
+      }
+    }
+    CueModel cues = new CueModel(cueNames, associations, present);
+    ForgetDlBridge.Outcome outcome = forgetDlBridge.decideTransition(input.cues(cues).build());
+    ForgetDlResult result = outcome.result();
+    String traceKey = "forget.dl." + rule.getRule_name();
+    int branchNumber = 0;
+    while (bundle.getExtraContent().containsKey(traceKey)) traceKey = "forget.dl." + rule.getRule_name() + ".branch" + ++branchNumber;
+    bundle.addExtraContent(traceKey, result.explain());
+    if (result.status() != ForgetDlResult.Status.OK || result.decision() == ForgetDlResult.Decision.UNKNOWN_COVERAGE
+        || result.decision() == ForgetDlResult.Decision.UNDECIDED_LOGIC || result.decision() == ForgetDlResult.Decision.NONE) {
+      throw new IllegalArgumentException("Forget-DL cannot certify rule " + rule.getRule_name() + ": " + result.explain());
+    }
+    if (!result.neglected().isEmpty()) {
+      for (Message forgotten : result.neglected()) {
+        for (Fact action : rule.getActions()) {
+          if (!nonInternal.contains(action.getF_name()) && action.getParameters().stream().anyMatch(p ->
+              Terms.subterms(parseStringToMessage(payloadToString(p))).stream().anyMatch(m ->
+                  sameDlTerm(m, forgotten)))) {
+            actionsToNeglect.add(factSignature(action));
+          }
+        }
+      }
+    }
+    ForgetContext after = new ForgetContext(outcome.knowledgeAfter(), outcome.forgetAfter(), ctx.getBlockingMode(), ctx.getTypeMap());
+    after.setProcedural(result.after().procedural());
+    after.setCues(new CueModel(cueNames, associations, Set.of()));
+    bundle.setForgetContext(after);
+    List<Message> targets = result.decision() == ForgetDlResult.Decision.REPLACE ? outcome.replacementTargets() : Collections.singletonList(target);
+    int limit = Math.min(targets.size(), effectiveMaxVariants(bundle));
+    if (targets.size() > limit || result.partial()) bundle.setVariantsTruncated(true);
+    List<DlBranch> next = new ArrayList<>();
+    for (int i = 0; i < limit; i++) {
+      ArrayList<Rule> theory = deepCloneTheory(branch.theory());
+      Rule changed = theory.stream().filter(r -> r.getId() == rule.getId()).findFirst().orElseThrow();
+      if (existing != null) writeDlState(dlState(changed.getPreconditions(), true), predecessorKnowledge);
+      writeDlState(dlState(changed.getPostconditions(), false), after.getKnowledge());
+      if (result.decision() == ForgetDlResult.Decision.REPLACE) {
+        Map<Message, Message> substitutions = outcome.replacementSubstitutions().get(i);
+        for (Fact action : changed.getActions()) {
+          applyDlActionSubstitutions(action, substitutions, immutableActions);
+        }
+        rewriteMatchingDlReceives(theory, changed, outgoing, targets.get(i), substitutions, immutableActions);
+        for (Fact out : changed.getPostconditions()) if (isOutboundFact(out.getF_name())) writeDlPayload(out, targets.get(i));
+        for (Fact action : changed.getActions()) if (isSendAction(action.getF_name())) writeDlPayload(action, targets.get(i));
+      } else if (result.decision() == ForgetDlResult.Decision.SKIP) {
+        removeDlSend(theory, changed);
+      } else if (result.decision() == ForgetDlResult.Decision.NEGLECT) {
+        removeNeglectedActions(changed, actionsToNeglect);
+      }
+      changed.getActions().removeIf(f -> ForgetMutationParser.DL_ANNOTATIONS.contains(f.getF_name()));
+      certifyDlOperationalOutputs(changed, after, cues, nonInternal, result.decision() == ForgetDlResult.Decision.NEGLECT);
+      if (result.decision() == ForgetDlResult.Decision.REPLACE || result.decision() == ForgetDlResult.Decision.SKIP
+          || result.decision() == ForgetDlResult.Decision.NEGLECT) {
+        changed.setRule_name(changed.getRule_name() + (limit > 1 ? "_M" + i : "_M"));
+        changed.setTypo(Type.MUTATED);
+      }
+      Map<String, ForgetContext> states = new LinkedHashMap<>(branch.states());
+      Fact post = dlState(rule.getPostconditions(), false);
+      if (post != null) states.put(stateKey(post), after.copy());
+      next.add(new DlBranch(theory, states));
+    }
+    return next;
+  }
+
+  private ForgetContext rebaseDlContext(ForgetContext context) {
+    Set<Message> knowledge = context.getKnowledge().stream().map(this::withoutFreshPrefix).collect(java.util.stream.Collectors.toCollection(LinkedHashSet::new));
+    Set<Message> forget = context.getForgetSet().stream().map(this::withoutFreshPrefix).collect(java.util.stream.Collectors.toCollection(LinkedHashSet::new));
+    ForgetContext rebased = new ForgetContext(knowledge, forget, context.getBlockingMode(), context.getTypeMap());
+    rebased.setProcedural(context.getProcedural());
+    Set<Association> associations = context.getCues().associations().stream()
+        .map(a -> new Association(a.cue(), withoutFreshPrefix(a.message()))).collect(java.util.stream.Collectors.toCollection(LinkedHashSet::new));
+    rebased.setCues(new CueModel(context.getCues().cues(), associations, Set.of()));
+    return rebased;
+  }
+
+  private Message withoutFreshPrefix(Message term) {
+    if (term instanceof Atom a) return new Atom(a.getValue().startsWith("~") ? a.getValue().substring(1) : a.getValue());
+    if (term instanceof Pair p) return new Pair(withoutFreshPrefix(p.getLeft()), withoutFreshPrefix(p.getRight()));
+    if (term instanceof Encrypt e) return new PredictiveFunction("senc", List.of(withoutFreshPrefix(e.getMsg()), withoutFreshPrefix(e.getKey())));
+    if (term instanceof PredictiveFunction f) return new PredictiveFunction(f.getName(), f.getArgs().stream().map(this::withoutFreshPrefix).toList());
+    throw new IllegalArgumentException("Unsupported Forget-DL term " + term);
+  }
+
+  private void writeDlPayload(Fact fact, Message payload) {
+    fact.getParameters().set(fact.getParameters().size() - 1, new Value(tamarinTerm(payload)));
+  }
+
+  private void applyDlActionSubstitutions(Fact action, Map<Message, Message> substitutions, Set<String> immutableActions) {
+    if (ForgetMutationParser.DL_ANNOTATIONS.contains(action.getF_name()) || immutableActions.contains(action.getF_name())) return;
+    int first = isSendAction(action.getF_name()) || isReceiveAction(action.getF_name()) ? action.getParameters().size() - 1 : 0;
+    for (int p = Math.max(first, 0); p < action.getParameters().size(); p++) {
+      Message original = parseStringToMessage(payloadToString(action.getParameter(p)));
+      Message replacement = substituteDl(original, substitutions);
+      if (!original.equals(replacement)) action.getParameters().set(p, new Value(tamarinTerm(replacement)));
+    }
+  }
+
+  private void rewriteMatchingDlReceives(ArrayList<Rule> theory, Rule sender, List<Fact> originals,
+      Message target, Map<Message, Message> substitutions, Set<String> immutableActions) {
+    for (Rule receiver : theory) {
+      if (receiver == sender) continue;
+      boolean matched = false;
+      Fact receivedFact = null;
+      for (Fact input : receiver.getPreconditions()) {
+        if (!isInboundFact(input.getF_name())) continue;
+        if (originals.stream().anyMatch(out -> sameDlChannel(out, input))) {
+          matched = true;
+          receivedFact = input;
+        }
+      }
+      if (matched) {
+        for (Message forgotten : substitutions.keySet()) {
+          if (!(forgotten instanceof Atom)) throw new IllegalArgumentException("Forget-DL directed replacement requires atomic receive-variable rebinding");
+          final Fact received = receivedFact;
+          if (receiver.getPreconditions().stream().filter(f -> f != received).flatMap(f -> f.getParameters().stream())
+              .anyMatch(p -> Terms.subterms(parseStringToMessage(payloadToString(p))).stream().anyMatch(m -> sameDlTerm(m, forgotten)))) {
+            throw new IllegalArgumentException("Forget-DL directed replacement would alter a receiver equality check in " + receiver.getRule_name());
+          }
+        }
+        rebindDlReceiverChain(theory, receiver, substitutions, immutableActions);
+        writeDlPayload(receivedFact, target);
+      }
+    }
+  }
+
+  private boolean sameDlTerm(Message left, Message right) {
+    return Terms.identity(withoutFreshPrefix(left)).equals(Terms.identity(withoutFreshPrefix(right)));
+  }
+
+  private void rebindDlReceiverChain(List<Rule> theory, Rule start, Map<Message, Message> substitutions, Set<String> immutableActions) {
+    Set<Integer> visited = new HashSet<>();
+    Deque<Rule> pending = new ArrayDeque<>(List.of(start));
+    while (!pending.isEmpty()) {
+      Rule rule = pending.removeFirst();
+      if (!visited.add(rule.getId())) continue;
+      for (Fact post : rule.getPostconditions()) {
+        if (isStateFact(post.getF_name())) {
+          String key = stateKey(post);
+          for (Rule next : theory) if (next.getPreconditions().stream().anyMatch(pre -> isStateFact(pre.getF_name()) && stateKey(pre).equals(key))) pending.add(next);
+        }
+      }
+      for (Fact action : rule.getActions()) applyDlActionSubstitutions(action, substitutions, immutableActions);
+      for (Fact fact : java.util.stream.Stream.concat(rule.getPreconditions().stream(), rule.getPostconditions().stream()).toList()) {
+        int first = isStateFact(fact.getF_name()) ? 2 : isInboundFact(fact.getF_name()) || isOutboundFact(fact.getF_name()) ? fact.getParameters().size() - 1 : 0;
+        for (int p = Math.max(first, 0); p < fact.getParameters().size(); p++) {
+          Message term = parseStringToMessage(payloadToString(fact.getParameter(p)));
+          Message rebound = substituteDl(term, substitutions);
+          if (!term.equals(rebound)) fact.getParameters().set(p, new Value(tamarinTerm(rebound)));
+        }
+      }
+    }
+  }
+
+  private boolean sameDlChannel(Fact out, Fact in) {
+    return out.getParameters().size() >= 4 && out.getParameters().size() == in.getParameters().size()
+        && canonicalize(out.getParameters().toString()).equals(canonicalize(in.getParameters().toString()));
+  }
+
+  private void writeDlState(Fact state, Set<Message> knowledge) {
+    if (state == null) return;
+    // ponytail: an inert public sentinel encodes empty K because Tamarin has no empty tuple.
+    String values = knowledge.stream().map(this::tamarinTerm).collect(java.util.stream.Collectors.joining(","));
+    String payload = knowledge.isEmpty() ? "'dl_empty'" : knowledge.size() == 1 ? values : "<" + values + ">";
+    state.getParameters().set(2, new Value(payload));
+  }
+
+  private Message substituteDl(Message term, Map<Message, Message> replacements) {
+    for (var entry : replacements.entrySet()) {
+      if (sameDlTerm(term, entry.getKey())) return entry.getValue();
+    }
+    if (term instanceof Pair p) return new Pair(substituteDl(p.getLeft(), replacements), substituteDl(p.getRight(), replacements));
+    if (term instanceof Encrypt e) return new Encrypt(substituteDl(e.getMsg(), replacements), substituteDl(e.getKey(), replacements));
+    if (term instanceof PredictiveFunction f) return new PredictiveFunction(f.getName(), f.getArgs().stream().map(a -> substituteDl(a, replacements)).toList());
+    return term;
+  }
+
+  private void certifyDlOperationalOutputs(Rule rule, ForgetContext after, CueModel cues,
+      Set<String> nonInternal, boolean neglect) {
+    for (Fact action : rule.getActions()) {
+      if (nonInternal.contains(action.getF_name())) continue;
+      for (Object parameter : action.getParameters()) certifyDlOperand(rule, "internal action " + action.getF_name(), parameter, after, cues);
+    }
+    for (Fact post : rule.getPostconditions()) {
+      if (isStateFact(post.getF_name())) continue;
+      if (isOutboundFact(post.getF_name())) {
+        if (neglect) certifyDlOperand(rule, "surviving send after Neglect", post.getParameter(post.getParameters().size() - 1), after, cues);
+      } else {
+        for (Object parameter : post.getParameters()) certifyDlOperand(rule, "output fact " + post.getF_name(), parameter, after, cues);
+      }
+    }
+  }
+
+  private void certifyDlOperand(Rule rule, String subject, Object parameter, ForgetContext after, CueModel cues) {
+    Message operand = parseStringToMessage(payloadToString(parameter));
+    var input = TransitionInput.builder(new HumanState(after.getKnowledge(), after.getForgetSet(), after.getProcedural()))
+        .send(operand).closure(after.getBlockingMode()).cues(cues).build();
+    var result = forgetDlBridge.decideTransition(input).result();
+    if (result.status() != ForgetDlResult.Status.OK || result.decision() != ForgetDlResult.Decision.PRESERVE) {
+      throw new IllegalArgumentException("Forget-DL cannot certify " + subject + " in " + rule.getRule_name() + ": " + result.explain());
+    }
+  }
+
+  private void validateDlBuiltinArities(List<Rule> rules, ParametersBundle bundle) {
+    Set<String> builtins = new HashSet<>();
+    if (bundle.getBuiltins() != null) for (Builtins declaration : bundle.getBuiltins()) builtins.addAll(declaration.getGroup());
+    String source = bundle.getExtraContent("forget.dl.source").replaceAll("(?s)/\\*.*?\\*/|//[^\\r\\n]*", " ");
+    var declarations = java.util.regex.Pattern.compile("\\bbuiltins\\s*:\\s*([A-Za-z-]+(?:\\s*,\\s*[A-Za-z-]+)*)").matcher(source);
+    while (declarations.find()) for (String name : declarations.group(1).split(",")) builtins.add(name.trim());
+    for (Rule rule : rules) {
+      for (Fact fact : java.util.stream.Stream.concat(rule.getPreconditions().stream(), java.util.stream.Stream.concat(rule.getActions().stream(), rule.getPostconditions().stream())).toList()) {
+        for (Object parameter : fact.getParameters()) {
+          for (Message term : Terms.subterms(parseStringToMessage(payloadToString(parameter)))) {
+            if (term instanceof PredictiveFunction function && ((builtins.contains("hashing") && function.getName().equals("h") && function.getArgs().size() != 1)
+                || (builtins.contains("signing") && function.getName().equals("sign") && function.getArgs().size() != 2))) {
+              throw new IllegalArgumentException("Forget-DL invalid builtin arity: " + function.getName());
+            }
+          }
+        }
+      }
+    }
+  }
+
+  private String tamarinTerm(Message message) {
+    if (message instanceof Atom a) return a.getValue();
+    if (message instanceof Pair p) return "<" + tamarinTerm(p.getLeft()) + "," + tamarinTerm(p.getRight()) + ">";
+    if (message instanceof Encrypt e) return "senc(" + tamarinTerm(e.getMsg()) + "," + tamarinTerm(e.getKey()) + ")";
+    if (message instanceof PredictiveFunction f) return f.getName() + "(" + f.getArgs().stream().map(this::tamarinTerm).collect(java.util.stream.Collectors.joining(",")) + ")";
+    throw new IllegalArgumentException("Unsupported Forget-DL message " + message);
+  }
+
+  private void removeDlSend(ArrayList<Rule> theory, Rule changed) {
+    List<Fact> sends = changed.getPostconditions().stream().filter(f -> isOutboundFact(f.getF_name())).toList();
+    changed.getPostconditions().removeAll(sends);
+    changed.getActions().removeIf(f -> isSendAction(f.getF_name()));
+    for (Rule receiver : theory) {
+      if (receiver == changed) continue;
+      boolean removed = receiver.getPreconditions().removeIf(f -> isInboundFact(f.getF_name()) && sends.stream().anyMatch(s -> sameDlChannel(s, f)));
+      if (removed) receiver.getActions().removeIf(f -> isReceiveAction(f.getF_name()));
+    }
+  }
+
+  private void validateDlBindings(Rule rule) {
+    Set<String> bound = new HashSet<>();
+    for (Fact pre : rule.getPreconditions()) {
+      for (Object parameter : pre.getParameters()) collectDlVariables(parseStringToMessage(payloadToString(parameter)), bound);
+    }
+    Set<String> used = new HashSet<>();
+    for (Fact fact : java.util.stream.Stream.concat(rule.getActions().stream(), rule.getPostconditions().stream()).toList()) {
+      for (Object parameter : fact.getParameters()) collectDlVariables(parseStringToMessage(payloadToString(parameter)), used);
+    }
+    used.removeAll(bound);
+    if (!used.isEmpty()) throw new IllegalArgumentException("Forget-DL output has unbound variables in " + rule.getRule_name() + ": " + new TreeSet<>(used));
+  }
+
+  private void collectDlVariables(Message term, Set<String> variables) {
+    for (Message subterm : Terms.subterms(term)) {
+      if (subterm instanceof Atom atom && atom.getValue().matches("~?[A-Za-z_][A-Za-z0-9_]*")) variables.add(canonicalize(atom.getValue()));
+    }
+  }
