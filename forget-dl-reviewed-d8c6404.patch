index 0000000..5111dc7
--- /dev/null
+++ b/src/main/java/com/xmen/service/forget/dl/ForgetDlBridge.java
@@ -0,0 +1,179 @@
+package com.xmen.service.forget.dl;
+
+import com.xmen.model.Atom;
+import com.xmen.model.Encrypt;
+import com.xmen.model.Message;
+import com.xmen.model.Pair;
+import com.xmen.model.PredictiveFunction;
+import com.xmen.service.forget.ForgetContext.BlockingMode;
+import com.xmen.service.forget.dl.ForgetDlModel.CueModel;
+import com.xmen.service.forget.dl.ForgetDlModel.HumanState;
+import com.xmen.service.forget.dl.ForgetDlModel.ProceduralState;
+import com.xmen.service.forget.dl.ForgetDlModel.TransitionInput;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+
+/**
+ * Adapter between the X-Men Forget pipeline (ForgetContext, parsed rule payloads, Forget(x)
+ * annotations) and {@link ForgetDlEngine}. Pure Java so it can be tested without Spring.
+ *
+ * <p>Host-representation choices (semantic contract A9, A10):
+ *
+ * <ul>
+ *   <li>Tamarin fresh-variable tildes are ignored ({@code ~pw1} ≡ {@code pw1}), as the host's
+ *       {@code canonicalize} already does.
+ *   <li>Public constants ({@code $X} and quoted {@code 'c'}) occurring in the intended send or in
+ *       a candidate are available to the agent; they are added to K for derivation only and are
+ *       not written back into the host state.
+ * </ul>
+ */
+public final class ForgetDlBridge {
+
+  /**
+   * Decision plus what the host needs to rewrite the rule.
+   *
+   * @param replacementSubstitutions one map {blocked → replacement} per Replace variant, in the
+   *     engine's deterministic order; keys and values are in the bridge's normalised form
+   * @param knowledgeAfter successor knowledge in host representation
+   * @param forgetAfter successor Forget set in host representation
+   */
+  public record Outcome(ForgetDlResult result, List<Map<Message, Message>> replacementSubstitutions,
+      List<Message> replacementTargets, Set<Message> knowledgeAfter, Set<Message> forgetAfter) {}
+
+  private final ForgetDlEngine engine;
+
+  public ForgetDlBridge() {
+    this(new ForgetDlEngine());
+  }
+
+  public ForgetDlBridge(ForgetDlEngine engine) {
+    this.engine = engine;
+  }
+
+  public Outcome decide(Set<Message> knowledge, Set<Message> forget, Message received,
+      List<Message> forgotten, Set<Message> forgottenUsedInInternalActions, Message target,
+      Function<Message, String> labelOf, BlockingMode mode) {
+    return decide(knowledge, forget, ProceduralState.EMPTY, received, forgotten,
+        forgottenUsedInInternalActions, target, labelOf, mode, CueModel.NONE);
+  }
+
+  public Outcome decide(Set<Message> knowledge, Set<Message> forget, ProceduralState procedural,
+      Message received, List<Message> forgotten, Set<Message> forgottenUsedInInternalActions,
+      Message target, Function<Message, String> labelOf, BlockingMode mode, CueModel cues) {
+    TransitionInput.Builder b = TransitionInput.builder(new HumanState(knowledge, forget, procedural))
+        .received(received).send(target).closure(mode).cues(cues);
+    forgotten.forEach(b::forget);
+    forgottenUsedInInternalActions.forEach(b::internalAction);
+    Set<Message> labelled = new LinkedHashSet<>(knowledge);
+    if (received != null) {
+      labelled.add(received);
+    }
+    for (Message x : labelled) {
+      String label = labelOf.apply(x);
+      if (label == null) {
+        label = labelOf.apply(normalise(x));
+      }
+      if (label != null) {
+        b.label(x, label);
+      }
+    }
+    return decideTransition(b.build());
+  }
+
+  /** Normalizes a complete host transition, including procedural lapses and cue associations. */
+  public Outcome decideTransition(TransitionInput input) {
+    Map<Message, Message> original = new LinkedHashMap<>();
+    Set<Message> k = normaliseAll(input.before().knowledge(), original);
+    Set<Message> f = normaliseAll(input.before().forget(), original);
+    Message m1 = input.received() == null ? null
+        : remember(normalise(input.received()), input.received(), original);
+    Message m2 = input.intendedSend() == null ? null : normalise(input.intendedSend());
+    Set<Message> derivationK = new LinkedHashSet<>(k);
+    if (m2 != null) {
+      Terms.subterms(m2).stream().filter(ForgetDlBridge::isPublicConstant).forEach(derivationK::add);
+    }
+    Set<ForgetDlModel.Association> associations = new LinkedHashSet<>();
+    for (ForgetDlModel.Association a : input.cues().associations()) {
+      associations.add(new ForgetDlModel.Association(a.cue(), normalise(a.message())));
+    }
+    CueModel cues = new CueModel(input.cues().cues(), associations, input.cues().present());
+    TransitionInput.Builder b = TransitionInput.builder(
+        new HumanState(derivationK, f, input.before().procedural()))
+        .received(m1).send(m2).closure(input.closure()).cues(cues);
+    for (ForgetDlModel.LapseEvent event : input.lapses()) {
+      if (event instanceof ForgetDlModel.MessageLapse ml) {
+        b.forget(remember(normalise(ml.message()), ml.message(), original));
+      } else {
+        b.lapse(event);
+      }
+    }
+    input.internalActionTerms().forEach(x -> b.internalAction(normalise(x)));
+    input.labels().forEach((x, label) -> b.label(normalise(x), label));
+    input.relearnedRules().forEach(b::relearnRule);
+    input.relearnedProcedures().forEach(b::relearnProcedure);
+    ForgetDlResult r = engine.run(b.build());
+
+    List<Map<Message, Message>> subs = new ArrayList<>();
+    List<Message> targets = new ArrayList<>();
+    for (ForgetDlResult.Candidate c : r.replacements()) {
+      subs.add(c.substitutions().get(0));
+      targets.add(c.target());
+    }
+    Set<Message> kAfter = new LinkedHashSet<>();
+    Set<Message> hostK = new LinkedHashSet<>(k);
+    if (m1 != null) {
+      hostK.add(m1);
+    }
+    for (Message x : r.after().knowledge()) {
+      if (hostK.contains(x)) {
+        kAfter.add(original.getOrDefault(x, x)); // A10: injected public constants are dropped
+      }
+    }
+    Set<Message> fAfter = new LinkedHashSet<>();
+    for (Message x : r.after().forget()) {
+      fAfter.add(original.getOrDefault(x, x));
+    }
+    return new Outcome(r, List.copyOf(subs), List.copyOf(targets), kAfter, fAfter);
+  }
+
+  private static Set<Message> normaliseAll(Set<Message> ms, Map<Message, Message> original) {
+    Set<Message> out = new LinkedHashSet<>();
+    for (Message m : ms) {
+      out.add(remember(normalise(m), m, original));
+    }
+    return out;
+  }
+
+  private static Message remember(Message norm, Message orig, Map<Message, Message> original) {
+    original.putIfAbsent(norm, orig);
+    return norm;
+  }
+
+  static boolean isPublicConstant(Message m) {
+    return m instanceof Atom a
+        && (a.getValue().startsWith("$") || (a.getValue().startsWith("'") && a.getValue().endsWith("'")));
+  }
+
+  /** Removes Tamarin fresh-variable tildes from atoms, recursively. */
+  static Message normalise(Message m) {
+    if (m instanceof Atom a) {
+      String v = a.getValue();
+      return v.startsWith("~") && v.length() > 1 ? new Atom(v.substring(1)) : m;
+    }
+    if (m instanceof Pair p) {
+      return new Pair(normalise(p.getLeft()), normalise(p.getRight()));
+    }
+    if (m instanceof Encrypt e) {
+      return new PredictiveFunction("senc", List.of(normalise(e.getMsg()), normalise(e.getKey())));
+    }
+    if (m instanceof PredictiveFunction fn) {
+      return new PredictiveFunction(fn.getName(), fn.getArgs().stream().map(ForgetDlBridge::normalise).toList());
+    }
+    return m;
+  }
+}
diff --git a/src/main/java/com/xmen/service/forget/dl/ForgetDlCompiler.java b/src/main/java/com/xmen/service/forget/dl/ForgetDlCompiler.java
new file mode 100644
index 0000000..1a20136
--- /dev/null
+++ b/src/main/java/com/xmen/service/forget/dl/ForgetDlCompiler.java
@@ -0,0 +1,191 @@
+package com.xmen.service.forget.dl;
+
+import com.xmen.model.Derivation;
+import com.xmen.model.Message;
+import com.xmen.service.forget.dl.DefeasibleTheory.Literal;
+import com.xmen.service.forget.dl.ForgetDlModel.Association;
+import com.xmen.service.forget.dl.ForgetDlModel.CueModel;
+import com.xmen.service.forget.dl.ForgetDlModel.ProceduralState;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * {@code compile(H, i+1, T, K)} of Algorithm 2, line 20. One theory is compiled for the whole
+ * candidate set T; atoms are indexed by target, so joint and separate compilation coincide.
+ *
+ * <p>Vocabulary (ground propositional atoms; the agent/state context is implicit in the theory):
+ *
+ * <pre>
+ * Known(x)            fact, x ∈ K                                  (§7.1)
+ * Lapsed(h)           fact, h ∈ ⋃_{t∈T} ⋃_{π∈Π_t} Blocked(Hyp_π)   (§7.1, §7.3)
+ * ContextCue(c,h)     fact, h lapsed, c ∈ Pres, (c,h) ∈ Assoc      (§7.5)
+ * LapsedRule(r)       fact, r ∈ R_H  (paper: Lapsed(Rule(r)))      (§7.6)
+ * LapsedProc(π)       fact, π ∈ Π_H  (paper: Lapsed(Proc(π)))      (§7.6)
+ * d:π      Known(h1..hk) ⇒ Via(π,t)
+ * use:π    Via(π,t) → Usable(t)
+ * w:π:h    Lapsed(h) ⇝ ¬Via(π,t)         for every h ∈ Hyp_π       w:π:h > d:π
+ * rho:π:h:c ContextCue(c,h) ⇒ Via(π,t)   h ∈ Blocked(Hyp_π), (c,h) ∈ Assoc; rho:π:h:c > w:π:h
+ * wr:π:r   LapsedRule(r) ⇝ ¬Via(π,t)     for every r ∈ Rules(π)    wr:π:r > d:π
+ * wp:π     LapsedProc(π) ⇝ ¬Via(π,t)                               wp:π > d:π
+ * </pre>
+ *
+ * Defeaters and reinstaters are emitted whether or not they are applicable; facts decide
+ * applicability. Usable(t) is declared for every t ∈ T, including targets without derivations.
+ */
+public final class ForgetDlCompiler {
+
+  /** Per-derivation compilation record used for decisions and the cognitive trace. */
+  public record DerivationEntry(
+      Message target,
+      Derivation derivation,
+      String procedureId,
+      Set<Message> hypotheses,
+      Set<Message> blockedHypotheses,
+      Set<String> rules,
+      Literal via,
+      String baseLabel,
+      Map<Message, String> declarativeDefeaters,
+      Map<String, String> ruleDefeaters,
+      String procedureDefeater,
+      Map<String, Message> reinstaters) {}
+
+  /** Compiled theory plus the index needed to read it back. */
+  public record Compiled(
+      DefeasibleTheory theory,
+      Map<Message, Literal> usable,
+      Map<Message, List<DerivationEntry>> entries,
+      Set<Message> lapsedMessages) {}
+
+  public Compiled compile(
+      Set<Message> knowledge,
+      ForgetBlocking blocking,
+      ProceduralState procedural,
+      CueModel cues,
+      Map<Message, List<Derivation>> derivationsByTarget) {
+
+    DefeasibleTheory.Builder b = DefeasibleTheory.builder();
+    for (Message x : Terms.sorted(knowledge)) {
+      b.fact(known(x));
+    }
+
+    // Lapsed(h): union of blocked hypotheses over all derivations of all targets.
+    Set<Message> lapsed = new LinkedHashSet<>();
+    Map<Message, List<Derivation>> ordered = new TreeMap<>(Terms.ORDER);
+    ordered.putAll(derivationsByTarget);
+    for (List<Derivation> ds : ordered.values()) {
+      for (Derivation d : ds) {
+        lapsed.addAll(blocking.blocked(NormalDerivations.hypotheses(d)));
+      }
+    }
+    for (Message h : Terms.sorted(lapsed)) {
+      b.fact(lapsedAtom(h));
+    }
+    for (Association a : cues.associations()) {
+      if (lapsed.contains(a.message()) && cues.present().contains(a.cue())) {
+        b.fact(contextCue(a.cue(), a.message()));
+      }
+    }
+    for (String r : procedural.forgottenRules()) {
+      b.fact(lapsedRule(r));
+    }
+    for (String p : procedural.forgottenProcedures()) {
+      b.fact(lapsedProc(p));
+    }
+
+    Map<Message, Literal> usable = new LinkedHashMap<>();
+    Map<Message, List<DerivationEntry>> entries = new LinkedHashMap<>();
+    Map<String, Message> seenIds = new LinkedHashMap<>();
+    for (Map.Entry<Message, List<Derivation>> e : ordered.entrySet()) {
+      Message t = e.getKey();
+      Literal u = Literal.pos("Usable(" + Terms.identity(t) + ")");
+      usable.put(t, u);
+      b.declare(u.atom());
+      List<DerivationEntry> list = new ArrayList<>();
+      for (Derivation d : e.getValue()) {
+        list.add(compileDerivation(b, t, d, u, blocking, cues, seenIds));
+      }
+      entries.put(t, Collections.unmodifiableList(list));
+    }
+    return new Compiled(b.build(), Collections.unmodifiableMap(usable),
+        Collections.unmodifiableMap(entries), Collections.unmodifiableSet(lapsed));
+  }
+
+  private DerivationEntry compileDerivation(DefeasibleTheory.Builder b, Message t, Derivation d,
+      Literal usable, ForgetBlocking blocking, CueModel cues, Map<String, Message> seenIds) {
+    String pid = NormalDerivations.procedureId(d);
+    if (seenIds.containsKey(pid)) {
+      throw new IllegalStateException("procedure id collision or duplicate derivation: " + pid);
+    }
+    seenIds.put(pid, t);
+    Set<Message> hyps = new LinkedHashSet<>(Terms.sorted(NormalDerivations.hypotheses(d)));
+    Set<Message> blocked = blocking.blocked(hyps);
+    Set<String> rules = NormalDerivations.rules(d);
+    Literal via = Literal.pos("Via(" + pid + "," + Terms.identity(t) + ")");
+
+    String base = "d:" + pid;
+    b.rule(new DefeasibleTheory.Rule(base, DefeasibleTheory.RuleKind.DEFEASIBLE,
+        hyps.stream().map(ForgetDlCompiler::known).toList(), via));
+    b.strict("use:" + pid, usable, via);
+
+    Map<Message, String> decl = new LinkedHashMap<>();
+    for (Message h : hyps) {
+      String w = "w:" + pid + ":" + Terms.identity(h);
+      b.defeater(w, via.complement(), lapsedAtom(h));
+      b.superior(w, base);
+      decl.put(h, w);
+    }
+    Map<String, Message> reinstaters = new LinkedHashMap<>();
+    for (Message h : blocked) {
+      for (Association a : cues.associations()) {
+        if (a.message().equals(h)) {
+          String rho = "rho:" + pid + ":" + Terms.identity(h) + ":" + Terms.field(a.cue());
+          if (!b.hasRule(rho)) {
+            b.defeasible(rho, via, contextCue(a.cue(), h));
+            b.superior(rho, decl.get(h));
+            reinstaters.put(rho, h);
+          }
+        }
+      }
+    }
+    Map<String, String> ruleDefs = new LinkedHashMap<>();
+    for (String r : rules) {
+      String wr = "wr:" + pid + ":" + r;
+      b.defeater(wr, via.complement(), lapsedRule(r));
+      b.superior(wr, base);
+      ruleDefs.put(r, wr);
+    }
+    String wp = "wp:" + pid;
+    b.defeater(wp, via.complement(), lapsedProc(pid));
+    b.superior(wp, base);
+    return new DerivationEntry(t, d, pid, Collections.unmodifiableSet(hyps),
+        Collections.unmodifiableSet(blocked), rules, via, base,
+        Collections.unmodifiableMap(decl), Collections.unmodifiableMap(ruleDefs), wp,
+        Collections.unmodifiableMap(reinstaters));
+  }
+
+  public static Literal known(Message x) {
+    return Literal.pos("Known(" + Terms.identity(x) + ")");
+  }
+
+  public static Literal lapsedAtom(Message x) {
+    return Literal.pos("Lapsed(" + Terms.identity(x) + ")");
+  }
+
+  public static Literal contextCue(String cue, Message x) {
+    return Literal.pos("ContextCue(" + Terms.field(cue) + "," + Terms.identity(x) + ")");
+  }
+
+  public static Literal lapsedRule(String r) {
+    return Literal.pos("LapsedRule(" + r + ")");
+  }
+
+  public static Literal lapsedProc(String p) {
+    return Literal.pos("LapsedProc(" + p + ")");
+  }
+}
diff --git a/src/main/java/com/xmen/service/forget/dl/ForgetDlEngine.java b/src/main/java/com/xmen/service/forget/dl/ForgetDlEngine.java
new file mode 100644
index 0000000..018fe76
--- /dev/null
+++ b/src/main/java/com/xmen/service/forget/dl/ForgetDlEngine.java
@@ -0,0 +1,402 @@
+package com.xmen.service.forget.dl;
+
+import com.xmen.model.Derivation;
+import com.xmen.model.Message;
+import com.xmen.service.forget.dl.DefeasibleReasoner.Conclusions;
+import com.xmen.service.forget.dl.DefeasibleTheory.Literal;
+import com.xmen.service.forget.dl.ForgetDlCompiler.Compiled;
+import com.xmen.service.forget.dl.ForgetDlModel.Association;
+import com.xmen.service.forget.dl.ForgetDlModel.HumanState;
+import com.xmen.service.forget.dl.ForgetDlModel.LapseEvent;
+import com.xmen.service.forget.dl.ForgetDlModel.MessageLapse;
+import com.xmen.service.forget.dl.ForgetDlModel.ProceduralState;
+import com.xmen.service.forget.dl.ForgetDlModel.ProcedureLapse;
+import com.xmen.service.forget.dl.ForgetDlModel.RuleLapse;
+import com.xmen.service.forget.dl.ForgetDlModel.TransitionInput;
+import com.xmen.service.forget.dl.ForgetDlResult.Candidate;
+import com.xmen.service.forget.dl.ForgetDlResult.Decision;
+import com.xmen.service.forget.dl.ForgetDlResult.Status;
+import com.xmen.service.forget.dl.NormalDerivations.Coverage;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.Optional;
+import java.util.NoSuchElementException;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Algorithm 2 (µ<sup>H</sup><sub>Forget−DL</sub>) of the paper, as a pure function from a
+ * {@link TransitionInput} to a {@link ForgetDlResult}. Deterministic: every iteration is over
+ * canonically sorted collections.
+ *
+ * <p>Implementation choices where the paper is silent are documented in
+ * {@code docs/forget-dl/SEMANTIC_CONTRACT.md} (A1–A12) and referenced inline.
+ */
+public final class ForgetDlEngine {
+
+  /** Engine limits. Exceeding any of them is reported as truncated coverage. */
+  public record Limits(NormalDerivations.Limits derivation, int maxCandidates) {
+    public static final Limits DEFAULT = new Limits(NormalDerivations.Limits.DEFAULT, 256);
+
+    public Limits {
+      Objects.requireNonNull(derivation, "derivation limits");
+      if (maxCandidates < 1) {
+        throw new IllegalArgumentException("candidate limit must be positive");
+      }
+    }
+  }
+
+  private final DefeasibleReasoner reasoner;
+  private final NormalDerivations derivations;
+  private final Set<String> privateFunctions;
+  private final Limits limits;
+  private final ForgetDlCompiler compiler = new ForgetDlCompiler();
+
+  public ForgetDlEngine() {
+    this(new AmbiguityBlockingReasoner(), Set.of(), Limits.DEFAULT);
+  }
+
+  public ForgetDlEngine(DefeasibleReasoner reasoner, Set<String> privateFunctions, Limits limits) {
+    this.reasoner = reasoner;
+    this.privateFunctions = Set.copyOf(privateFunctions);
+    this.limits = limits;
+    this.derivations = new NormalDerivations(this.privateFunctions, limits.derivation());
+  }
+
+  public ForgetDlResult run(TransitionInput in) {
+    HumanState before = in.before();
+    Message m1 = in.received();
+    Message m2 = in.intendedSend();
+    List<String> notes = new ArrayList<>();
+
+    // ---- Input validation (explicit failures, never semantic decisions) ----
+    List<Message> toCheck = new ArrayList<>(before.knowledge());
+    toCheck.addAll(before.forget());
+    toCheck.addAll(in.internalActionTerms());
+    in.cues().associations().forEach(a -> toCheck.add(a.message()));
+    in.lapses().forEach(e -> {
+      if (e instanceof MessageLapse ml) toCheck.add(ml.message());
+    });
+    if (m1 != null) {
+      toCheck.add(m1);
+    }
+    if (m2 != null) {
+      toCheck.add(m2);
+    }
+    for (Message x : toCheck) {
+      Optional<String> bad = Terms.unsupportedConstruct(x);
+      if (bad.isPresent()) {
+        return ForgetDlResult.failure(Status.UNSUPPORTED, List.of(bad.get()), before);
+      }
+    }
+    for (LapseEvent e : in.lapses()) {
+      if (e instanceof MessageLapse ml && !ml.message().equals(m1)
+          && !before.knowledge().contains(ml.message())) {
+        return ForgetDlResult.failure(Status.INVALID_INPUT, List.of("lapsed message "
+            + Terms.canonical(ml.message()) + " is neither received nor in K^i (Def. 4)"), before);
+      }
+    }
+    for (Association a : in.cues().associations()) {
+      if (!in.cues().cues().contains(a.cue())) {
+        return ForgetDlResult.failure(Status.INVALID_INPUT,
+            List.of("association uses undeclared cue " + a.cue()), before);
+      }
+    }
+    if (!in.cues().cues().containsAll(in.cues().present())) {
+      return ForgetDlResult.failure(Status.INVALID_INPUT,
+          List.of("Pres is not a subset of Cue (Def. 8)"), before);
+    }
+
+    // ---- Lines 2-12: state update ----
+    Set<Message> k1 = new LinkedHashSet<>(before.knowledge());
+    if (m1 != null) {
+      k1.add(m1);
+    }
+    Set<Message> forget1 = new LinkedHashSet<>(before.forget());
+    Set<String> rules1 = new TreeSet<>(before.procedural().forgottenRules());
+    Set<String> procs1 = new TreeSet<>(before.procedural().forgottenProcedures());
+    boolean forgotReceived = false;
+    Set<Message> lapsedNow = new LinkedHashSet<>();
+    for (LapseEvent e : in.lapses()) {
+      switch (e) {
+        case MessageLapse ml -> {
+          forget1.add(ml.message());
+          lapsedNow.add(ml.message());
+          if (ml.message().equals(m1)) {
+            forgotReceived = true; // line 4, first branch: K stays K^i
+          }
+        }
+        case RuleLapse rl -> rules1.add(rl.rule());
+        case ProcedureLapse pl -> procs1.add(pl.procedureId());
+      }
+    }
+    if (forgotReceived) {
+      k1 = new LinkedHashSet<>(before.knowledge());
+    }
+    for (Association a : in.cues().associations()) {
+      if (!k1.contains(a.message())) {
+        return ForgetDlResult.failure(Status.INVALID_INPUT, List.of("association ("
+            + a.cue() + "," + Terms.canonical(a.message()) + ") outside K^{i+1} (Def. 8)"), before);
+      }
+    }
+
+    // Independent recovery events still update persistent competence when Neglect returns.
+    // Multiple events apply lapses first, then explicit recovery.
+    rules1.removeAll(in.relearnedRules());
+    procs1.removeAll(in.relearnedProcedures());
+
+    // ---- Lines 5-6: Neglect with early return (A8: re-acquisition is not applied) ----
+    Set<Message> neglected = new LinkedHashSet<>();
+    for (LapseEvent e : in.lapses()) {
+      if (e instanceof MessageLapse ml) {
+        for (Message a : Terms.sorted(in.internalActionTerms())) {
+          if (Terms.occursIn(ml.message(), a)) {
+            neglected.add(ml.message());
+          }
+        }
+      }
+    }
+    if (!neglected.isEmpty()) {
+      HumanState after = new HumanState(k1, forget1, new ProceduralState(rules1, procs1));
+      return new ForgetDlResult(Status.OK, Decision.NEGLECT, List.copyOf(notes), after,
+          Set.of(), neglected, List.of(), List.of(), Coverage.COMPLETE, false, null, null,
+          List.of());
+    }
+
+    // ---- Line 13: re-acquisition (A6) ----
+    ProceduralState proc1 = new ProceduralState(rules1, procs1);
+    Set<Message> reacquired = new LinkedHashSet<>();
+    Set<Message> unresolvedReacquisition = new LinkedHashSet<>();
+    if (m1 != null && !forgotReceived) {
+      boolean changed = true;
+      while (changed) {
+        changed = false;
+        ForgetBlocking blocking = new ForgetBlocking(forget1, in.closure(), privateFunctions);
+        for (Message f : Terms.sorted(forget1)) {
+          if (lapsedNow.contains(f)) {
+            continue; // a lapse of this transition is not undone by the same receipt
+          }
+          if (f.equals(m1) || recoverableVia(f, m1, k1, blocking, proc1, notes, unresolvedReacquisition)) {
+            forget1.remove(f);
+            unresolvedReacquisition.remove(f);
+            reacquired.add(f);
+            changed = true;
+            break;
+          }
+        }
+      }
+    }
+    HumanState after = new HumanState(k1, forget1, proc1);
+
+    if (m2 == null) {
+      return new ForgetDlResult(Status.OK,
+          unresolvedReacquisition.isEmpty() ? Decision.NO_SEND : Decision.UNKNOWN_COVERAGE,
+          List.copyOf(notes), after,
+          reacquired, Set.of(), List.of(), List.of(), Coverage.COMPLETE, false, null, null,
+          List.of());
+    }
+
+    // ---- Lines 14-19: candidate targets ----
+    ForgetBlocking blocking = new ForgetBlocking(forget1, in.closure(), privateFunctions);
+    NormalDerivations.Result r2 = derivations.enumerate(m2, after.knowledge());
+    if (r2.coverage() == Coverage.UNSUPPORTED) {
+      return ForgetDlResult.failure(Status.UNSUPPORTED, List.of(r2.note()), after);
+    }
+    Coverage candidateCoverage = decisionCoverage(r2, proc1, notes);
+    Map<Message, List<Map<Message, Message>>> provenance = new LinkedHashMap<>();
+    provenance.put(m2, new ArrayList<>());
+    List<Message> kSorted = Terms.sorted(after.knowledge());
+    int combinationsChecked = 0;
+    outer:
+    for (Derivation pi : r2.derivations()) {
+      Set<Message> blocked = blocking.blocked(NormalDerivations.hypotheses(pi));
+      if (blocked.isEmpty()) {
+        continue;
+      }
+      List<Message> keys = new ArrayList<>(blocked);
+      List<List<Message>> sets = new ArrayList<>();
+      for (Message b : keys) {
+        List<Message> rb = replacementSet(b, kSorted, forget1, in.labels());
+        if (rb.isEmpty()) {
+          continue outer; // Algorithm 1 line 19-20: no replacement, next π
+        }
+        sets.add(rb);
+      }
+      for (Map<Message, Message> c : combinations(keys, sets)) {
+        if (combinationsChecked++ >= limits.derivation().maxSteps()) {
+          candidateCoverage = Coverage.TRUNCATED;
+          notes.add("replacement combination work limit reached");
+          break outer;
+        }
+        Message variant = Terms.substitute(m2, c);
+        if (variant.equals(m2)) {
+          continue; // no blocked hypothesis occurs in m2: m2[C] = m2, already in T
+        }
+        if (!provenance.containsKey(variant) && provenance.size() >= limits.maxCandidates()) {
+          candidateCoverage = Coverage.TRUNCATED;
+          notes.add("candidate limit " + limits.maxCandidates() + " reached");
+          break outer;
+        }
+        List<Map<Message, Message>> prov = provenance.computeIfAbsent(variant, k -> new ArrayList<>());
+        // One deterministic substitution witnesses a target; additional witnesses emit no trace.
+        if (prov.isEmpty()) {
+          prov.add(Map.copyOf(c));
+        }
+      }
+    }
+
+    // ---- Π_t for every t ∈ T ----
+    Map<Message, List<Derivation>> byTarget = new LinkedHashMap<>();
+    Map<Message, Coverage> coverage = new LinkedHashMap<>();
+    for (Message t : provenance.keySet()) {
+      NormalDerivations.Result rt = t.equals(m2) ? r2 : derivations.enumerate(t, after.knowledge());
+      if (rt.coverage() == Coverage.UNSUPPORTED) {
+        return ForgetDlResult.failure(Status.UNSUPPORTED, List.of(rt.note()), after);
+      }
+      byTarget.put(t, rt.derivations());
+      coverage.put(t, decisionCoverage(rt, proc1, notes));
+      if (rt.coverage() == Coverage.TRUNCATED) {
+        notes.add("derivation enumeration truncated for " + Terms.canonical(t));
+      }
+    }
+
+    // ---- Lines 20-21: one theory for all candidates ----
+    Compiled compiled = compiler.compile(after.knowledge(), blocking, proc1, in.cues(), byTarget);
+    Conclusions conc = reasoner.reason(compiled.theory());
+
+    List<Candidate> candidates = new ArrayList<>();
+    for (Message t : provenance.keySet()) {
+      candidates.add(new Candidate(t, t.equals(m2), List.copyOf(provenance.get(t)),
+          coverage.get(t), conc.partialTag(compiled.usable().get(t))));
+    }
+
+    // ---- Lines 22-31: decision ----
+    Literal u2 = compiled.usable().get(m2);
+    Decision decision;
+    List<Candidate> replacements = new ArrayList<>();
+    boolean partial = false;
+    if (!unresolvedReacquisition.isEmpty()) {
+      decision = Decision.UNKNOWN_COVERAGE;
+    } else if (conc.provable(u2)) {
+      decision = Decision.PRESERVE;
+    } else if (!conc.refuted(u2)) {
+      decision = Decision.UNDECIDED_LOGIC;
+    } else if (coverage.get(m2) != Coverage.COMPLETE) {
+      decision = Decision.UNKNOWN_COVERAGE;
+    } else {
+      boolean allConclusive = candidateCoverage == Coverage.COMPLETE;
+      for (Candidate c : candidates) {
+        if (c.intended()) {
+          continue;
+        }
+        Literal u = compiled.usable().get(c.target());
+        if (conc.provable(u)) {
+          replacements.add(c);
+        } else if (!conc.refuted(u) || c.derivationCoverage() != Coverage.COMPLETE) {
+          allConclusive = false;
+        }
+      }
+      if (!replacements.isEmpty()) {
+        decision = Decision.REPLACE;
+        partial = !allConclusive;
+      } else {
+        decision = allConclusive ? Decision.SKIP : Decision.UNKNOWN_COVERAGE;
+      }
+    }
+    return new ForgetDlResult(Status.OK, decision, List.copyOf(notes), after, reacquired,
+        Set.of(), List.copyOf(candidates), List.copyOf(replacements), candidateCoverage, partial,
+        compiled, conc, ForgetDlResult.buildTrace(compiled, conc, m2));
+  }
+
+  /**
+   * R<sub>m̄</sub> (Algorithm 2, line 17): known, not syntactically forgotten, same format, same
+   * (known) label, and different from m̄ itself (A5).
+   */
+  private static List<Message> replacementSet(Message b, List<Message> kSorted,
+      Set<Message> forget, Map<Message, String> labels) {
+    String label = labels.get(b);
+    List<Message> out = new ArrayList<>();
+    if (label == null) {
+      return out; // A4: without a label, no type-safe replacement exists
+    }
+    String format = Terms.format(b);
+    for (Message x : kSorted) {
+      if (!x.equals(b) && !forget.contains(x) && format.equals(Terms.format(x))
+          && label.equals(labels.get(x))) {
+        out.add(x);
+      }
+    }
+    return out;
+  }
+
+  private static Iterable<Map<Message, Message>> combinations(List<Message> keys,
+      List<List<Message>> sets) {
+    // ponytail: enumerate lazily; the candidate/work caps must apply before Cartesian expansion.
+    return () -> new Iterator<>() {
+      private final int[] indices = new int[keys.size()];
+      private boolean available = sets.stream().noneMatch(List::isEmpty);
+
+      public boolean hasNext() {
+        return available;
+      }
+
+      public Map<Message, Message> next() {
+        if (!available) {
+          throw new NoSuchElementException();
+        }
+        Map<Message, Message> next = new LinkedHashMap<>();
+        for (int i = 0; i < keys.size(); i++) {
+          next.put(keys.get(i), sets.get(i).get(indices[i]));
+        }
+        available = false;
+        for (int i = indices.length - 1; i >= 0; i--) {
+          if (++indices[i] < sets.get(i).size()) {
+            available = true;
+            break;
+          }
+          indices[i] = 0;
+        }
+        return next;
+      }
+    };
+  }
+
+  private static Coverage decisionCoverage(NormalDerivations.Result r, ProceduralState p,
+      List<String> notes) {
+    if (r.cyclicDerivations() && !p.forgottenProcedures().isEmpty()) {
+      String note = "whole-procedure lapse requires cyclic proofs outside the finite basis for "
+          + Terms.canonical(r.target());
+      if (!notes.contains(note)) {
+        notes.add(note);
+      }
+      return Coverage.TRUNCATED;
+    }
+    return r.coverage();
+  }
+
+  /** A6: f is re-acquired if some derivation of f uses the received m1 and nothing blocked. */
+  private boolean recoverableVia(Message f, Message m1, Set<Message> k1, ForgetBlocking blocking,
+      ProceduralState procedural, List<String> notes, Set<Message> unresolved) {
+    NormalDerivations.Result r = derivations.enumerate(f, k1);
+    for (Derivation d : r.derivations()) {
+      Set<Message> hyps = NormalDerivations.hypotheses(d);
+      if (hyps.contains(m1) && blocking.blocked(hyps).isEmpty()
+          && java.util.Collections.disjoint(NormalDerivations.rules(d), procedural.forgottenRules())
+          && !procedural.forgottenProcedures().contains(NormalDerivations.procedureId(d))) {
+        return true;
+      }
+    }
+    if (r.coverage() != Coverage.COMPLETE || r.cyclicDerivations()) {
+      unresolved.add(f);
+      notes.add("re-acquisition check for " + Terms.canonical(f) + " incomplete ("
+          + (r.cyclicDerivations() ? "cyclic receipt provenance" : r.coverage())
+          + "); successor forgetting state is uncertain");
+    }
+    return false;
+  }
+}
diff --git a/src/main/java/com/xmen/service/forget/dl/ForgetDlModel.java b/src/main/java/com/xmen/service/forget/dl/ForgetDlModel.java
