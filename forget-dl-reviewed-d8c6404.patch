+[ State('H','2',a)
+, Fr(~n)
+]
+--[ H()
+, Send('H','fresh',~n)
+]->
+[ State('H','3',<a,~n>)
+, Out(~n)
+]
+
+rule H3:
+[ State('H','3',<a,n>)
+]
+--[ H()
+, Send('H','later',n)
