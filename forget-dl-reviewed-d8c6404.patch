+package com.xmen.utilities;
+
+import static org.junit.jupiter.api.Assertions.*;
+import com.xmen.model.ParametersBundle;
+import com.xmen.model.Rule;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class FileHandlerSingleRuleTest {
+  @Test
+  void aSingleRuleIsRetainedAndHasNoNeighbors() {
+    Rule rule = new Rule("Only");
+    var bundle = new ParametersBundle();
+    bundle.setTheory(new ArrayList<>(List.of(rule)));
+    new FileHandler().arrangeTheory(bundle);
+    assertEquals(List.of(rule), bundle.getTheory());
+    assertNull(rule.getPrevious());
+    assertNull(rule.getNext());
+  }
+}
diff --git a/src/test/resources/Forget_DL_Invoice_Cue.spthy b/src/test/resources/Forget_DL_Invoice_Cue.spthy
new file mode 100644
index 0000000..ac18c3b
--- /dev/null
+++ b/src/test/resources/Forget_DL_Invoice_Cue.spthy
@@ -0,0 +1,22 @@
+/* Minimal executable invoice decision fixture: public order fields, private signing key, two typed account candidates. */
+theory InvoiceDL
+begin
+builtins: asymmetric-encryption, signing
+/****RULES****/
+rule humansetup:
+ [Fr(~accS),Fr(~accAtt),Fr(~skH),Fr(~skB)]
+ --[OnlyOnce(),IntendedAccount('H',~accS)]->
+ [!Type('H','account',~accS),!Type('H','account',~accAtt),State('H','1',<'H','B','S','service','amount',~accS,~accAtt,~skH,pk(~skB)>)]
+rule H1:
+ [State('H','1',<'H','B','S','service','amount',accS,accAtt,skH,pkB>)]
+ --[H(),Forget(accS),Cue('independent'),AssociateCue('independent',accS),PresentCue('independent'),Send('H','order',aenc(sign(<'H','B','S','service','amount',accS>,skH),pkB))]-> [Out(aenc(sign(<'H','B','S','service','amount',accS>,skH),pkB))]
+/****ENDOFRULES****/
+restriction OnlyOnce:
+ "All #i #j. OnlyOnce()@i & OnlyOnce()@j ==> #i = #j"
+lemma Functional: exists-trace
+ "Ex payload #i. Send('H','order',payload)@i"
+lemma Wrong_Account_Exists: exists-trace
+ "Ex desired actual skH skB #i #j. IntendedAccount('H',desired)@i & Send('H','order',aenc(sign(<'H','B','S','service','amount',actual>,skH),pk(skB)))@j & not (desired = actual)"
+lemma No_Wrong_Account:
+ "All desired actual skH skB #i #j. IntendedAccount('H',desired)@i & Send('H','order',aenc(sign(<'H','B','S','service','amount',actual>,skH),pk(skB)))@j ==> desired = actual"
+end
