+    collect(m, out);
+    return out;
+  }
+
+  public static Set<Message> subterms(Iterable<Message> ms) {
+    Set<Message> out = new LinkedHashSet<>();
+    for (Message m : ms) {
+      collect(m, out);
+    }
+    return out;
+  }
