index 0000000..5c5eb0d
--- /dev/null
+++ b/src/main/java/com/xmen/service/forget/dl/ForgetDlResult.java
@@ -0,0 +1,204 @@
+package com.xmen.service.forget.dl;
+
+import com.xmen.model.Message;
+import com.xmen.service.forget.dl.DefeasibleReasoner.Conclusions;
+import com.xmen.service.forget.dl.DefeasibleTheory.Literal;
+import com.xmen.service.forget.dl.DefeasibleTheory.Rule;
+import com.xmen.service.forget.dl.ForgetDlCompiler.Compiled;
+import com.xmen.service.forget.dl.ForgetDlCompiler.DerivationEntry;
+import com.xmen.service.forget.dl.ForgetDlModel.HumanState;
+import com.xmen.service.forget.dl.NormalDerivations.Coverage;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Outcome of one application of Algorithm 2, with its cognitive trace (Section 7.4). */
+public record ForgetDlResult(
+    Status status,
+    Decision decision,
+    List<String> notes,
+    HumanState after,
+    Set<Message> reacquired,
+    Set<Message> neglected,
+    List<Candidate> candidates,
+    List<Candidate> replacements,
+    Coverage candidateCoverage,
+    boolean partial,
+    Compiled compiled,
+    Conclusions conclusions,
+    List<TargetTrace> trace) {
+
+  /** Processing status; anything but OK carries no semantic decision. */
+  public enum Status {
+    OK,
+    INVALID_INPUT,
+    UNSUPPORTED
+  }
+
+  /** Algorithm 2 outcome, plus explicit non-decisions. */
+  public enum Decision {
+    /** +∂Usable(m2): the intended send is kept (line 23). */
+    PRESERVE,
+    /** −∂Usable(m2) and V ≠ ∅: one Replace per usable variant (lines 25-28). */
+    REPLACE,
+    /** −∂Usable(m2), V = ∅, complete coverage (line 30). */
+    SKIP,
+    /** A lapsed message is used in an internal action (lines 5-6). */
+    NEGLECT,
+    /** The transition has no send; only the state update applies. */
+    NO_SEND,
+    /** Negative evidence rests on a truncated enumeration: no Replace/Skip claim. */
+    UNKNOWN_COVERAGE,
+    /** The theory leaves Usable(m2) without a defeasible tag. */
+    UNDECIDED_LOGIC,
+    /** No decision (invalid input or unsupported algebra). */
+    NONE
+  }
+
+  /** A target in T with the syntactic substitutions C that produced it. */
+  public record Candidate(
+      Message target,
+      boolean intended,
+      List<Map<Message, Message>> substitutions,
+      Coverage derivationCoverage,
+      String usableTag) {}
+
+  public enum BlockerKind {
+    DECLARATIVE,
+    RULE,
+    PROCEDURE
+  }
+
+  /** An applicable opposing defeater and the applicable supporting rules superior to it. */
+  public record Blocker(BlockerKind kind, String label, String subject, List<String> overruledBy) {
+    public boolean standing() {
+      return overruledBy.isEmpty();
+    }
+  }
+
+  /** Trace of one derivation π: its Via tag, applicable support and blockers. */
+  public record DerivationTrace(
+      String procedureId,
+      String viaTag,
+      Set<Message> hypotheses,
+      Set<Message> blockedHypotheses,
+      Set<String> rules,
+      List<String> applicableSupport,
+      List<Blocker> blockers) {
+
+    public List<Blocker> standing() {
+      return blockers.stream().filter(Blocker::standing).toList();
+    }
+  }
+
+  /** Trace of one target: Usable tag and per-derivation explanation. */
+  public record TargetTrace(Message target, boolean intended, String usableTag,
+      List<DerivationTrace> derivations) {
+
+    public boolean noDerivation() {
+      return derivations.isEmpty();
+    }
+  }
+
+  static ForgetDlResult failure(Status s, List<String> notes, HumanState after) {
+    return new ForgetDlResult(s, Decision.NONE, List.copyOf(notes), after, Set.of(), Set.of(),
+        List.of(), List.of(), Coverage.COMPLETE, false, null, null, List.of());
+  }
+
+  /** Builds the cognitive trace from the compiled theory and its tagged conclusions. */
+  static List<TargetTrace> buildTrace(Compiled compiled, Conclusions c, Message intended) {
+    List<TargetTrace> out = new ArrayList<>();
+    for (Map.Entry<Message, List<DerivationEntry>> e : compiled.entries().entrySet()) {
+      Message t = e.getKey();
+      List<DerivationTrace> ds = new ArrayList<>();
+      for (DerivationEntry d : e.getValue()) {
+        List<String> support = new ArrayList<>();
+        List<Rule> supportRules = new ArrayList<>();
+        Rule base = compiled.theory().rule(d.baseLabel());
+        if (applicable(base, c)) {
+          support.add(base.label());
+          supportRules.add(base);
+        }
+        for (String rho : d.reinstaters().keySet()) {
+          Rule r = compiled.theory().rule(rho);
+          if (applicable(r, c)) {
+            support.add(rho);
+            supportRules.add(r);
+          }
+        }
+        List<Blocker> blockers = new ArrayList<>();
+        d.declarativeDefeaters().forEach((h, label) ->
+            addBlocker(blockers, compiled, c, supportRules, BlockerKind.DECLARATIVE, label,
+                Terms.canonical(h)));
+        d.ruleDefeaters().forEach((r, label) ->
+            addBlocker(blockers, compiled, c, supportRules, BlockerKind.RULE, label, r));
+        addBlocker(blockers, compiled, c, supportRules, BlockerKind.PROCEDURE,
+            d.procedureDefeater(), d.procedureId());
+        ds.add(new DerivationTrace(d.procedureId(), c.partialTag(d.via()), d.hypotheses(),
+            d.blockedHypotheses(), d.rules(), List.copyOf(support), List.copyOf(blockers)));
+      }
+      out.add(new TargetTrace(t, t.equals(intended),
+          c.partialTag(compiled.usable().get(t)), List.copyOf(ds)));
+    }
+    return List.copyOf(out);
+  }
+
+  private static void addBlocker(List<Blocker> out, Compiled compiled, Conclusions c,
+      List<Rule> support, BlockerKind kind, String label, String subject) {
+    Rule s = compiled.theory().rule(label);
+    if (!applicable(s, c)) {
+      return;
+    }
+    List<String> by = support.stream()
+        .filter(t -> compiled.theory().isSuperior(t.label(), s.label()))
+        .map(Rule::label)
+        .toList();
+    out.add(new Blocker(kind, label, subject, by));
+  }
+
+  private static boolean applicable(Rule r, Conclusions c) {
+    for (Literal l : r.body()) {
+      if (!c.provable(l)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  /** Readable explanation of the decision and of every target's tag. */
+  public String explain() {
+    StringBuilder sb = new StringBuilder();
+    sb.append("status=").append(status).append(" decision=").append(decision);
+    if (partial) {
+      sb.append(" (partial: candidate set not exhaustive)");
+    }
+    sb.append('\n');
+    for (String n : notes) {
+      sb.append("note: ").append(n).append('\n');
+    }
+    for (TargetTrace t : trace) {
+      sb.append(t.intended() ? "intended " : "variant  ").append(Terms.canonical(t.target()))
+          .append(": ").append(t.usableTag()).append("Usable");
+      if (t.noDerivation()) {
+        sb.append(" — no normal derivation (Π = ∅)");
+      }
+      sb.append('\n');
+      for (DerivationTrace d : t.derivations()) {
+        sb.append("  ").append(d.procedureId()).append(' ').append(d.viaTag()).append("Via")
+            .append(" rules=").append(d.rules()).append(" support=").append(d.applicableSupport())
+            .append('\n');
+        for (Blocker b : d.blockers()) {
+          sb.append("    ").append(b.standing() ? "standing " : "overruled ")
+              .append(b.kind()).append(' ').append(b.subject()).append(" [").append(b.label())
+              .append(']');
+          if (!b.standing()) {
+            sb.append(" by ").append(b.overruledBy());
+          }
+          sb.append('\n');
+        }
+      }
+    }
+    return sb.toString();
+  }
+}
diff --git a/src/main/java/com/xmen/service/forget/dl/NormalDerivations.java b/src/main/java/com/xmen/service/forget/dl/NormalDerivations.java
new file mode 100644
index 0000000..75513ae
--- /dev/null
+++ b/src/main/java/com/xmen/service/forget/dl/NormalDerivations.java
@@ -0,0 +1,301 @@
+package com.xmen.service.forget.dl;
+
+import com.xmen.model.Derivation;
+import com.xmen.model.Message;
+import com.xmen.model.Pair;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.HexFormat;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Enumerates &#928;<sub>m</sub>: the normal derivations of a target from a finite knowledge set
+ * (paper Section 3.2), as {@link Derivation} trees using the X-Men conventions ("Initial" leaves).
+ *
+ * <p>Inference rules (labels used by procedural forgetting, Definition 7):
+ *
+ * <ul>
+ *   <li>composition: {@code pair}, {@code senc}, {@code aenc}, and every other public constructor
+ *       under its own symbol (e.g. {@code sign}, {@code h}, {@code pk}, user functions);
+ *   <li>decomposition: {@code proj} (pair decomposition, i ∈ {1,2}), {@code sdec} (premises:
+ *       ciphertext, key), {@code adec} (premises: ciphertext {@code aenc(m,pk(sk))}, sk).
+ * </ul>
+ *
+ * <p>Normality: a decomposition is never applied to the output of its inverse composition. In
+ * addition, no term is repeated on a root-to-leaf branch (assumption A3); this subsumes the
+ * "nor vice versa" cases and makes &#928;<sub>m</sub> finite, because every term of such a
+ * derivation is a subterm of K ∪ {m}. Decryption nodes always carry both the ciphertext and the
+ * key premise, so both are hypotheses when they are leaves.
+ *
+ * <p>Coverage is explicit: exceeding a limit yields {@link Coverage#TRUNCATED}, never a silently
+ * shortened "complete" set.
+ */
+public final class NormalDerivations {
+
+  public static final String INITIAL = "Initial";
+
+  public enum Coverage {
+    COMPLETE,
+    TRUNCATED,
+    UNSUPPORTED
+  }
+
+  /** Enumeration limits; reaching either one marks the result as truncated. */
+  public record Limits(int maxDerivationsPerGoal, int maxSteps) {
+    public static final Limits DEFAULT = new Limits(512, 250_000);
+  }
+
+  /** Result for one target. {@code derivations} is sorted and duplicate-free. */
+  public record Result(Message target, List<Derivation> derivations, Coverage coverage,
+      String note) {
+    public Result {
+      derivations = List.copyOf(derivations);
+    }
+  }
+
+  private final Set<String> privateFunctions;
+  private final Limits limits;
+
+  public NormalDerivations() {
+    this(Set.of(), Limits.DEFAULT);
+  }
+
+  public NormalDerivations(Set<String> privateFunctions, Limits limits) {
+    this.privateFunctions = Set.copyOf(privateFunctions);
+    this.limits = limits;
+  }
+
+  public Result enumerate(Message target, Set<Message> knowledge) {
+    Optional<String> bad = Terms.unsupportedConstruct(target);
+    if (bad.isEmpty()) {
+      for (Message k : Terms.sorted(knowledge)) {
+        bad = Terms.unsupportedConstruct(k);
+        if (bad.isPresent()) {
+          break;
+        }
+      }
+    }
+    if (bad.isPresent()) {
+      return new Result(target, List.of(), Coverage.UNSUPPORTED, bad.get());
+    }
+    Run run = new Run(knowledge);
+    List<Derivation> found = run.derive(target, new HashSet<>());
+    List<Derivation> sorted = new ArrayList<>(new LinkedHashSet<>(found));
+    sorted.sort(Comparator.comparing(NormalDerivations::canonicalTree));
+    return new Result(target, sorted,
+        run.truncated ? Coverage.TRUNCATED : Coverage.COMPLETE,
+        run.truncated ? "limit reached: " + limits : "");
+  }
+
+  /** Hyp<sub>π</sub>: the knowledge leaves of a derivation. */
+  public static Set<Message> hypotheses(Derivation d) {
+    Set<Message> out = new LinkedHashSet<>();
+    collectHyps(d, out);
+    return out;
+  }
+
+  private static void collectHyps(Derivation d, Set<Message> out) {
+    if (INITIAL.equals(d.getRule())) {
+      out.add(d.getGoal());
+      return;
+    }
+    for (Derivation p : d.getPremises()) {
+      collectHyps(p, out);
+    }
+  }
+
+  /** Rules(π): the distinct inference-rule labels used by a derivation (Definition 7). */
+  public static Set<String> rules(Derivation d) {
+    Set<String> out = new TreeSet<>();
+    collectRules(d, out);
+    return out;
+  }
+
+  private static void collectRules(Derivation d, Set<String> out) {
+    if (!INITIAL.equals(d.getRule())) {
+      out.add(d.getRule());
+    }
+    for (Derivation p : d.getPremises()) {
+      collectRules(p, out);
+    }
+  }
+
+  /** Canonical tree rendering: identical trees have identical strings at every state. */
+  public static String canonicalTree(Derivation d) {
+    StringBuilder sb = new StringBuilder();
+    appendTree(d, sb);
+    return sb.toString();
+  }
+
+  private static void appendTree(Derivation d, StringBuilder sb) {
+    sb.append(d.getRule()).append('[').append(Terms.canonical(d.getGoal())).append(']');
+    if (!d.getPremises().isEmpty()) {
+      sb.append('(');
+      for (int i = 0; i < d.getPremises().size(); i++) {
+        if (i > 0) {
+          sb.append(';');
+        }
+        appendTree(d.getPremises().get(i), sb);
+      }
+      sb.append(')');
+    }
+  }
+
+  /**
+   * Stable procedure identifier of a derivation tree (Definition 7): independent of display
+   * labels, state, context revision and enumeration order.
+   */
+  public static String procedureId(Derivation d) {
+    try {
+      byte[] h = MessageDigest.getInstance("SHA-256")
+          .digest(canonicalTree(d).getBytes(StandardCharsets.UTF_8));
+      return "pi_" + HexFormat.of().formatHex(h, 0, 8);
+    } catch (NoSuchAlgorithmException e) {
+      throw new IllegalStateException("SHA-256 unavailable", e);
+    }
+  }
+
+  /** Human-readable multi-line rendering of a derivation tree. */
+  public static String render(Derivation d) {
+    StringBuilder sb = new StringBuilder();
+    render(d, 0, sb);
+    return sb.toString();
+  }
+
+  private static void render(Derivation d, int depth, StringBuilder sb) {
+    sb.append("  ".repeat(depth)).append(d.getRule()).append(" ⇒ ")
+        .append(Terms.canonical(d.getGoal())).append('\n');
+    for (Derivation p : d.getPremises()) {
+      render(p, depth + 1, sb);
+    }
+  }
+
+  /** One enumeration run over a fixed knowledge set. */
+  private final class Run {
+    private final Set<Message> knowledge;
+    private final Map<Message, List<Message>> pairsContaining = new HashMap<>();
+    private final Map<Message, List<Terms.Cipher>> ciphersOf = new HashMap<>();
+    private int steps;
+    private boolean truncated;
+
+    Run(Set<Message> knowledge) {
+      this.knowledge = Set.copyOf(knowledge);
+      for (Message s : Terms.sorted(Terms.subterms(knowledge))) {
+        if (s instanceof Pair p) {
+          pairsContaining.computeIfAbsent(p.getLeft(), k -> new ArrayList<>()).add(p);
+          if (!p.getRight().equals(p.getLeft())) {
+            pairsContaining.computeIfAbsent(p.getRight(), k -> new ArrayList<>()).add(p);
+          }
+        }
+        Terms.symmetric(s).ifPresent(
+            c -> ciphersOf.computeIfAbsent(c.plaintext(), k -> new ArrayList<>()).add(c));
+        Terms.asymmetric(s).ifPresent(
+            c -> ciphersOf.computeIfAbsent(c.plaintext(), k -> new ArrayList<>()).add(c));
+      }
+    }
+
+    private boolean full(List<Derivation> out) {
+      if (out.size() >= limits.maxDerivationsPerGoal()) {
+        truncated = true;
+        return true;
+      }
+      return false;
+    }
+
+    List<Derivation> derive(Message goal, Set<Message> branch) {
+      List<Derivation> out = new ArrayList<>();
+      if (branch.contains(goal)) {
+        return out;
+      }
+      if (++steps > limits.maxSteps()) {
+        truncated = true;
+        return out;
+      }
+      Set<Message> next = new HashSet<>(branch);
+      next.add(goal);
+
+      // Hypothesis (leaf).
+      if (knowledge.contains(goal)) {
+        out.add(new Derivation(goal, INITIAL, List.of()));
+      }
+
+      // Composition.
+      Optional<String> ctor = Terms.constructorLabel(goal, privateFunctions);
+      if (ctor.isPresent()) {
+        List<List<Derivation>> options = new ArrayList<>();
+        for (Message a : Terms.args(goal)) {
+          List<Derivation> ds = derive(a, next);
+          if (ds.isEmpty()) {
+            options = null;
+            break;
+          }
+          options.add(ds);
+        }
+        if (options != null) {
+          product(goal, ctor.get(), options, 0, new ArrayList<>(), out);
+        }
+      }
+
+      // Pair decomposition: main premise must not come from pair composition.
+      for (Message p : pairsContaining.getOrDefault(goal, List.of())) {
+        for (Derivation dp : derive(p, next)) {
+          if (full(out)) {
+            return out;
+          }
+          if (!"pair".equals(dp.getRule())) {
+            out.add(new Derivation(goal, "proj", List.of(dp)));
+          }
+        }
+      }
+
+      // Decryption: ciphertext must not come from the matching encryption.
+      for (Terms.Cipher c : ciphersOf.getOrDefault(goal, List.of())) {
+        List<Derivation> cipherDs = derive(c.ciphertext(), next);
+        if (cipherDs.isEmpty()) {
+          continue;
+        }
+        List<Derivation> keyDs = derive(c.decryptionKey(), next);
+        for (Derivation dc : cipherDs) {
+          if (c.encryptLabel().equals(dc.getRule())) {
+            continue;
+          }
+          for (Derivation dk : keyDs) {
+            if (full(out)) {
+              return out;
+            }
+            out.add(new Derivation(goal, c.decryptLabel(), List.of(dc, dk)));
+          }
+        }
+      }
+      return out;
+    }
+
+    private void product(Message goal, String label, List<List<Derivation>> options, int i,
+        List<Derivation> acc, List<Derivation> out) {
+      if (i == options.size()) {
+        if (!full(out)) {
+          out.add(new Derivation(goal, label, List.copyOf(acc)));
+        }
+        return;
+      }
+      for (Derivation d : options.get(i)) {
+        if (truncated && out.size() >= limits.maxDerivationsPerGoal()) {
+          return;
+        }
+        acc.add(d);
+        product(goal, label, options, i + 1, acc, out);
+        acc.remove(acc.size() - 1);
+      }
+    }
+  }
+}
