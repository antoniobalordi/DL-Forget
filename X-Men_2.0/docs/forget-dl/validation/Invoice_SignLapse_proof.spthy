theory InvoiceDL

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, pair/2, pk/1, sign/2, snd/1, true/0,
           verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) humansetup:
   [ Fr( ~accS ), Fr( ~accAtt ), Fr( ~skH ), Fr( ~skB ) ]
  --[ OnlyOnce( ), IntendedAccount( 'H', ~accS ) ]->
   [
   !Type( 'H', 'account', ~accS ), !Type( 'H', 'account', ~accAtt ),
   State( 'H', '1',
          <'H', 'B', 'S', 'service', 'amount', ~accS, ~accAtt, ~skH, pk(~skB)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) H1_M:
   [
   State( 'H', '1',
          <'H', 'B', 'S', 'service', 'amount', accS, accAtt, skH, pkB>
   )
   ]
  --[ H( ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction OnlyOnce:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  */

lemma Functional:
  exists-trace "∃ payload #i. Send( 'H', 'order', payload ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ payload #i. (Send( 'H', 'order', payload ) @ #i)"
*/
simplify
by solve( Send( 'H', 'order', payload ) @ #i )

lemma Wrong_Account_Exists:
  exists-trace
  "∃ desired actual skH skB #i #j.
    ((IntendedAccount( 'H', desired ) @ #i) ∧
     (Send( 'H', 'order',
            aenc(sign(<'H', 'B', 'S', 'service', 'amount', actual>, skH), pk(skB))
      ) @ #j)) ∧
    (¬(desired = actual))"
/*
guarded formula characterizing all satisfying traces:
"∃ desired actual skH skB #i #j.
  (IntendedAccount( 'H', desired ) @ #i) ∧
  (Send( 'H', 'order',
         aenc(sign(<'H', 'B', 'S', 'service', 'amount', actual>, skH), pk(skB))
   ) @ #j)
 ∧
  ¬(desired = actual)"
*/
simplify
by solve( Send( 'H', 'order',
                aenc(sign(<'H', 'B', 'S', 'service', 'amount', actual>, skH.1),
                     pk(skB.1))
          ) @ #j )

lemma No_Wrong_Account:
  all-traces
  "∀ desired actual skH skB #i #j.
    ((IntendedAccount( 'H', desired ) @ #i) ∧
     (Send( 'H', 'order',
            aenc(sign(<'H', 'B', 'S', 'service', 'amount', actual>, skH), pk(skB))
      ) @ #j)) ⇒
    (desired = actual)"
/*
guarded formula characterizing all counter-examples:
"∃ desired actual skH skB #i #j.
  (IntendedAccount( 'H', desired ) @ #i) ∧
  (Send( 'H', 'order',
         aenc(sign(<'H', 'B', 'S', 'service', 'amount', actual>, skH), pk(skB))
   ) @ #j)
 ∧
  ¬(desired = actual)"
*/
simplify
by solve( Send( 'H', 'order',
                aenc(sign(<'H', 'B', 'S', 'service', 'amount', actual>, skH.1),
                     pk(skB.1))
          ) @ #j )

/* All wellformedness checks were successful. */

